{
  "name": "@zanix/space-ui",
  "version": "1.0.0",
  "zanix": {
    "project": "library"
  },
  // `render-pipeline.ts` only ever resolves correctly as a SUBPROCESS run with `@zanix/space`'s own
  // `deno.jsonc` (`--config`) plus an ephemeral import map `space-import-map.ts` builds at test-run
  // time (never a static file) — see that fixture's own header doc. It's never statically imported
  // by anything in this repo (only referenced by path string, then handed to `Deno.Command`), has
  // no `.test.ts` suffix so `deno test`'s own glob never discovers it either, and its real
  // invocation already passes `--no-check`. Excluded here so `deno check`/the editor's live
  // diagnostics stop reporting its `modules/`/`typings/`-prefixed specifiers as unresolved — they
  // only ever resolve against `space`'s own config, never this package's.
  "exclude": [
    "src/@tests/functional/space-integration/fixtures/render-pipeline.ts"
  ],
  "compilerOptions": {
    // Explicit because Deno's default `lib` set depends on invocation shape: config-driven
    // discovery (this package's own `test.include` glob) resolves a DOM-inclusive default, while
    // an explicit file path CLI argument (e.g. `deno test path/to/file.test.tsx`) resolves a
    // narrower, DOM-exclusive one. Real source files here (`shared/close-on-outside.ts`,
    // `components/Menu/render.ts`, ...) use ordinary DOM APIs (`document`, `Node`, `FocusEvent`,
    // `HTMLElement.contains`/`.querySelector`), which need `lib` declared explicitly to
    // type-check consistently under either invocation shape.
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr",
        "react",
        "jsx"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist",
      "src/@tests/functional/space-integration/fixtures/render-pipeline.ts"
    ],
    "plugins": [
      "jsr:@zanix/utils@^4.1.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist",
      "src/@tests/functional/space-integration/fixtures/render-pipeline.ts"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "components/": "./src/components/",
    "typings/": "./src/typings/",
    "intl/": "./src/intl/",
    // Small internal mechanisms genuinely shared by more than one component's own implementation
    // (never a public export of this package) — e.g. `close-on-outside.ts`, first written for
    // `Menu`, moved here once `Modal` became a real second consumer. Never introduced ahead of a
    // real second need.
    "shared/": "./src/shared/",
    "@zanix/space/video-source": "jsr:@zanix/space@^1.0.0/video-source",
    "@zanix/space/assets-manifest": "jsr:@zanix/space@^1.0.0/assets-manifest",
    "@zanix/helpers": "jsr:@zanix/utils@^4.1.0/helpers",
    // The browser-safe entry only — `Modal`/`Drawer`'s own `render.ts` (via `shared/client-logger.ts`)
    // is the one place in this package that needs a `Logger` at all, and never the full,
    // server-capable `@zanix/utils/logger` (see that shared module's own doc for the real,
    // reproduced regression pulling that entry into a browser bundle caused: `WorkerManager`,
    // `Deno.readTextFile`-backed storage, and remote `https://jsr.io/...` fetches for
    // `@std/fmt/colors`/`@std/path` on every page load).
    "@zanix/utils/logger/client": "jsr:@zanix/utils@^4.1.0/logger/client",
    "@std/fmt": "jsr:@std/fmt@0.224",
    "@std/path": "jsr:@std/path@0.224",
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0",
    "@types/react": "npm:@types/react@^19.2.0",
    "@types/react-dom": "npm:@types/react-dom@^19.2.0",
    // Only ever fetched/evaluated by code under the "./preact" subpath — a consumer who only
    // imports the default (React) entrypoint never pulls this in.
    "preact": "npm:preact@^10.29.0",
    "preact-render-to-string": "npm:preact-render-to-string@^6.5.0",
    // Types only, zero runtime — `Thing`/`WithContext` are pure TS types (schema.org's own JSON-LD
    // vocabulary), never a value imported at runtime.
    "schema-dts": "npm:schema-dts@^1.1.5",
    // The one real formatting dependency this package owns (see `src/intl/formatter.ts`'s own
    // doc) — `@zanix/space` itself never depends on either of these, by design: ICU/AST is a
    // presentation-layer concern, resolved here, not in the routing/rendering core.
    "@formatjs/intl": "npm:@formatjs/intl@^4.1.19",
    // Types only, zero runtime — `MessageFormatElement` is `intl`'s own AST node type, imported
    // here only to type a precompiled catalog's values accurately (same reasoning as `schema-dts`
    // above). The actual ICU parser (`parse()`) is never imported anywhere in this package —
    // compiling ICU→AST is `@zanix/cli`'s own job, not this package's.
    "@formatjs/icu-messageformat-parser": "npm:@formatjs/icu-messageformat-parser@^3.5.17",
    // This package's second real runtime dependency (after `@zanix/space`). Only the `/markdown`
    // subpath is ever imported (`RichText/markdown.ts`) — its own `parser()` is a pure
    // markdown→AST function with zero React import at runtime (confirmed directly against its
    // real `dist/markdown.js`, not assumed from the package's own React-flavored root entrypoint
    // or its `.d.ts`'s purely-type-level `import * as React`), which is exactly why this package
    // can render markdown through Preact without ever touching `preact/compat` — this package
    // walks the AST itself via `h`, never markdown-to-jsx's own `./react` renderer.
    "markdown-to-jsx/markdown": "npm:markdown-to-jsx@^9.10.2/markdown"
  },
  "scopes": {
    "./src/@tests/": {
      // Test-only, never reachable from `mod.ts`/`mod-preact.ts` (confirmed by the same dependency-
      // boundary test pattern `intl/dependency-boundary.test.ts` already uses). `Counter` is the
      // first component whose contract lives inside `useEffect` — `renderToStaticMarkup`/
      // `preact-render-to-string` never run those — so its tests mount into a real DOM instead of
      // asserting static markup. See `src/@tests/unit/components/counter-test-utils.ts`'s own doc.
      // `happy-dom`, not `jsdom` — same real-DOM bootstrap role, zero transitive dependencies
      // (`jsdom` pulled in the now-deprecated `whatwg-encoding`/`glob@10` via `html-encoding-sniffer`).
      "happy-dom": "npm:happy-dom@^20.11.2",
      "@std/assert": "jsr:@std/assert@0.224"
    }
  },
  "exports": {
    ".": "./mod.ts",
    "./preact": "./mod-preact.ts",
    // The six components with a REAL runtime dependency on `@zanix/space` — split out of the
    // barrel above entirely, never re-exported from there. See `src/runtime.ts`'s own `@module`
    // doc for why.
    "./runtime": "./src/runtime.ts",
    "./runtime/preact": "./src/runtime-preact.ts"
  },
  "nodeModulesDir": "auto",
  "publish": {
    "exclude": [
      ".github",
      "src/@tests",
      // Internal architecture/roadmap record for this repo's own maintainers and contributors —
      // unlike `docs/styling.md`/`docs/icons.md` (genuinely consumer-facing: how to use/style what
      // ships today), this discusses unbuilt future components, internal audit reasoning, and gaps
      // in a sibling package (`@zanix/space`) that a consumer of THIS package has no need to see in
      // their installed copy's own docs. Stays in the git repo (visible on GitHub, where
      // contributors actually need it) but never ships inside the published JSR package.
      "docs/architecture.md"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts",
      "src/@tests/**/*.test.tsx"
    ]
  },
  "tasks": {
    "test": "deno test -A",
    // `src/@tests/functional/space-integration/` drives a real render pipeline from the sibling
    // `@zanix/space` repo (i18n parity tests) — `deno test --coverage` instruments whatever actually
    // runs, so a plain `deno coverage` report ends up mixing that entire external repo (and ITS OWN
    // npm/JSR dependencies) into this package's own numbers. `--coverage-raw-data-only` skips the
    // automatic (unfiltered) report `--coverage` alone would generate, and every report below is
    // filtered to this package's own `space-ui/src/` — never `space/src/` (the sibling repo), which
    // that include pattern can't match.
    "test:coverage": "rm -rf coverage && deno test -A --coverage=coverage --coverage-raw-data-only && deno coverage coverage --include='space-ui/src/' && deno coverage coverage --include='space-ui/src/' --lcov --output=coverage/lcov.info && deno coverage coverage --include='space-ui/src/' --html"
  }
}
